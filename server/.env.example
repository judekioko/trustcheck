# Copy this file to .env and fill in your own values. Never commit .env.

# JWT signing secret. If omitted, a random one is generated and persisted to
# server/data/.jwt-secret on first run (fine for local dev, not for prod).
JWT_SECRET=

# --- Safaricom Daraja (M-Pesa) ---
# Sandbox setup:
#   1. Register a free app at https://developer.safaricom.co.ke
#   2. Copy its Consumer Key / Consumer Secret below.
#   3. Leave DARAJA_SHORTCODE and DARAJA_PASSKEY unset to use Safaricom's
#      published sandbox defaults (shortcode 174379).
#   4. DARAJA_CALLBACK_URL must be a PUBLIC https URL (Safaricom's servers call
#      it directly) — e.g. an ngrok tunnel during development:
#        ngrok http 8787
#      then set this to https://<your-ngrok-subdomain>.ngrok-free.app/api/billing/mpesa/callback
#   5. Sandbox STK pushes only deliver to Safaricom's test MSISDN 254708374149.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
